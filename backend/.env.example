DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/autotestvision
ADB_PATH=adb
# 本机访问；局域网 IP 来源由后端 cors_origin_regex 自动放行（私网段）
CORS_ORIGINS=http://localhost:5179,http://127.0.0.1:5179

# Agent Test Service - 在线 LLM（可选，不配置且未选 local 时回退启发式）
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_VERIFY_MODEL=

# Agent Test Service - 本地 Ollama（OpenAI 兼容端点）
# 容器内默认连宿主机：http://host.docker.internal:11434/v1
# 本地裸跑后端时改成 http://localhost:11434/v1
AGENT_LOCAL_BASE_URL=http://localhost:11434/v1

# 执行后截图前等待（毫秒），避免截到白屏或过渡动画
AGENT_AFTER_CAPTURE_DELAY_MS=2000
AGENT_LOCAL_MODEL=gemma4:12b
AGENT_LOCAL_API_KEY=ollama

# 默认 provider：local | online
AGENT_DEFAULT_PROVIDER=local

# 数据飞轮产物目录（JSONL 导出、RAG、训练 artifact）
FLYWHEEL_ARTIFACT_DIR=data/flywheel

# AgentTest_Code pytest 工作区
AGENT_CODE_WORKSPACE_DIR=../.runtime/agent_code_runs
# 默认 false：进程内执行 u2；true 时成功后再跑 pytest 子进程
AGENT_CODE_RUN_PYTEST_SUBPROCESS=false
